{
  "name": "dsh-llm-acp",
  "version": "0.2.4",
  "description": "Expose local ACP CLI agents (kiro-cli, codebuddy, …) as DeepSeek Harness LLM provider routes, with a usage console and one-click CLI setup",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "docs/market-index.json"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "acp",
    "agent-client-protocol",
    "llm-provider"
  ],
  "homepage": "https://github.com/yingcaihuang/dsh-llm-acp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingcaihuang/dsh-llm-acp.git"
  },
  "scripts": {
    "test": "node test/discover.mjs && node test/quota-probe.mjs && node test/dashboard-async.mjs && node test/errors-port.mjs && node test/backoff-port.mjs && node test/models-cache-port.mjs && node test/credits-port.mjs && node test/effort-port.mjs && node test/askuser-port.mjs && node test/usage-metrics.mjs && node test/version-sync.mjs && node test/retry-delay.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
